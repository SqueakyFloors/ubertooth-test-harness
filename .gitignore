.DS_Store
.venv/
.idea/
__pycache__/
*.py[cod]
.runs/
runs/
hardware.yaml
harness-open.conf

# ESP-IDF writes the resolved configuration next to the project; the
# checked-in source is sdkconfig.defaults.
firmware/*/sdkconfig
firmware/*/sdkconfig.old

# "idf.py set-target" writes a build directory next to the project unless
# -B sends it elsewhere. Nothing generated belongs in the repository.
firmware/*/build/
