.DS_Store
.venv
.venv/
.idea/
__pycache__/
*.py[cod]
.runs/
runs/
hardware.yaml
harness-open.conf

# ESP-IDF writes the resolved configuration next to the project; the
# checked-in source is sdkconfig.defaults.
firmware/*/sdkconfig
firmware/*/sdkconfig.old

# scripts/test.py remembers how long each module took, to start the longest
# first next time (and writes it through a .test-durations-*.tmp).
tests/.test-durations.json
tests/.test-durations-*.tmp
