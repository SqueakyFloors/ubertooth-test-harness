# Acroname BrainStem devices, so a USBHub3+ can be driven without root.
#
# The harness talks to the hub over its own USB control link (BrainStem), not
# through a device file of its own, so the permissions of the raw USB node are
# what decide whether a normal account can switch a port. Without this rule
# only root can, and the Acroname driver fails to connect.
#
# Install it, then reload and replug the hub:
#
#   sudo install -m 644 scripts/lab/99-acroname.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Change the group to one the harness account is in. Acroname ships a script
# of its own that does the same job (udev.sh, in the BrainStem driverless
# package); this file is here so a bench can be set up from this repository
# and so the group is recorded with the rest of the bench.
#
# 0x24ff is Acroname's USB vendor ID; mode 0664 is read and write for the
# owner and the group, read for everyone else.
SUBSYSTEM=="usb", ATTRS{idVendor}=="24ff", GROUP="plugdev", MODE="0664"
