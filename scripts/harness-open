#!/usr/bin/env bash
# Open the lab controller's web GUI from a laptop (macOS or Linux): start an
# SSH local port forward to the controller's 127.0.0.1 port, wait until it
# answers, open http://127.0.0.1:PORT/ui/ in the browser, and keep the tunnel
# in the foreground until Ctrl-C.
#
#   scripts/harness-open [--host HOST] [--jump JUMP] [--port N] [--two-hop]
#
# No host is built in. Name the lab host with --host, with HARNESS_HOST in the
# environment, or in a private config file of shell assignments (HARNESS_HOST,
# HARNESS_JUMP, HARNESS_PORT) at $HARNESS_OPEN_CONFIG, by default
# $XDG_CONFIG_HOME/ubertooth-harness/harness-open.conf (so
# ~/.config/ubertooth-harness/harness-open.conf unless XDG_CONFIG_HOME is set).
# The script refuses to run without one. The jump host comes the same way;
# unset or empty means a direct connection.
#
# An option wins over the environment, which wins over the file. An empty
# HARNESS_JUMP is a choice (no jump host) and wins; an empty HARNESS_HOST or
# HARNESS_PORT is nothing to go on and falls through to the file. The file is
# sourced as shell, so it must be owned by you and not writable by anyone
# else; the script refuses it otherwise.
#
# Both ends are loopback only: the forward is
# -L 127.0.0.1:LOCAL:127.0.0.1:PORT, so nothing else on the laptop's network
# can use it, and it reaches only the controller's loopback listener.
#
# When a jump host is set, it relays the connection (ssh -J JUMP HOST). Use
# --two-hop when the jump host does not allow that (ssh reports "channel 0:
# open failed: administratively prohibited" or "stdio forwarding failed"), or
# when HOST is a name only the jump host's own SSH configuration knows. It
# runs ssh -t -L ... JUMP ssh -N -L ... HOST and relays through a Unix socket
# on the jump host that only your jump-host account can open (mode 0600), not
# a TCP port: the controller has no authentication, so a loopback TCP port on
# a shared jump host would let every user there drive it.
#
# Options:
#   --host HOST         controller host (default $HARNESS_HOST; required)
#   --jump JUMP         SSH jump host or alias (default $HARNESS_JUMP;
#                       "" for none)
#   --port N            controller port on HOST (default $HARNESS_PORT, or
#                       8765)
#   --local-port N      port on this machine (default: --port). The controller
#                       accepts only Host: 127.0.0.1:PORT, so a different
#                       local port gets 403 from it.
#   --jump-socket PATH  Unix socket on the jump host for --two-hop (default
#                       /tmp/ubertooth-harness-JUMPUSER-PORT.sock, JUMPUSER
#                       from ssh -G JUMP)
#   --two-hop           forward through two ssh sessions (see above)
#   --wait SECONDS      how long to wait for the tunnel (default 60)
#   --no-browser        open the tunnel only, print the URL
#   --dry-run           print the ssh command; run nothing
#   -h, --help          this help
set -euo pipefail

say() { printf 'harness-open: %s\n' "$*" >&2; }
die() { printf 'harness-open: error: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,/^set -euo/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'; }

# Before anything that can fail, so --help works even with a bad config file.
for arg in "$@"; do
    case $arg in -h|--help) usage; exit 0 ;; esac
done

config=${HARNESS_OPEN_CONFIG:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/ubertooth-harness/harness-open.conf}
# The environment wins over the config file, so remember it before sourcing.
env_host=${HARNESS_HOST-}
env_jump=${HARNESS_JUMP-}
env_jump_set=${HARNESS_JUMP+yes}
env_port=${HARNESS_PORT-}
if [ -f "$config" ]; then
    # Sourcing runs whatever the file contains, so accept only a file that is
    # yours and that no one else can write; $HARNESS_OPEN_CONFIG could
    # otherwise point at a file another local user controls.
    [ -O "$config" ] || die "$config is not owned by you; refusing to source it"
    mode=$(stat -f '%Lp' "$config" 2>/dev/null) || mode=$(stat -c '%a' "$config" 2>/dev/null) || mode=
    if [ -n "$mode" ] && [ "$(( 0$mode & 0022 ))" -ne 0 ]; then
        die "$config is writable by others (mode $mode); chmod go-w it"
    fi
    # Read it like a shell profile: a failing line inside must not kill this
    # script without a word, so drop errexit and check the status instead.
    set +e
    # The file is the user's own and lives outside the repository, so there
    # is nothing for a linter to follow.
    # shellcheck source=/dev/null
    . "$config"
    status=$?
    set -e
    [ "$status" -eq 0 ] || die "$config failed (status $status); fix it or unset HARNESS_OPEN_CONFIG"
fi
[ -z "$env_host" ] || HARNESS_HOST=$env_host
[ -z "$env_jump_set" ] || HARNESS_JUMP=$env_jump
[ -z "$env_port" ] || HARNESS_PORT=$env_port

host=${HARNESS_HOST-}
jump=${HARNESS_JUMP-}
port=${HARNESS_PORT:-8765}
host_option=0
local_port=
jump_socket=
two_hop=0
wait_s=60
browser=1
dry_run=0

while [ "$#" -gt 0 ]; do
    case $1 in
        --host|--jump|--port|--local-port|--jump-socket|--wait)
            [ "$#" -ge 2 ] || die "$1 needs a value"
            case $1 in
                --host) host=$2; host_option=1 ;;
                --jump) jump=$2 ;;
                --port) port=$2 ;;
                --local-port) local_port=$2 ;;
                --jump-socket) jump_socket=$2 ;;
                --wait) wait_s=$2 ;;
            esac
            shift ;;
        --two-hop) two_hop=1 ;;
        --no-browser) browser=0 ;;
        --dry-run) dry_run=1 ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown option $1 (see --help)" ;;
    esac
    shift
done

local_port=${local_port:-$port}

check_port() {
    case $2 in
        ''|*[!0-9]*) die "$1 must be a number from 1 to 65535" ;;
    esac
    if [ "$2" -lt 1 ] || [ "$2" -gt 65535 ]; then die "$1 must be a number from 1 to 65535"; fi
}
check_port --port "$port"
check_port --local-port "$local_port"
case $wait_s in ''|*[!0-9]*) die "--wait must be a whole number of seconds" ;; esac

# Host names become ssh arguments (and, with --two-hop, part of a remote
# command), so allow only plain host/alias characters and no leading '-'.
check_name() {
    case $2 in
        -*|*[!A-Za-z0-9._@-]*) die "$1 must be a host name or SSH alias: $2" ;;
    esac
}
if [ -z "$host" ]; then
    [ "$host_option" = 0 ] || die "--host must not be empty"
    die "no lab host: pass --host HOST, set HARNESS_HOST, or name one in $config"
fi
check_name --host "$host"
[ -z "$jump" ] || check_name --jump "$jump"
[ "$two_hop" = 0 ] || [ -n "$jump" ] || die "--two-hop needs --jump"

[ "$local_port" = "$port" ] || say "warning: --local-port $local_port differs from --port $port; the controller refuses Host: 127.0.0.1:$local_port with 403"

opts=(-o ExitOnForwardFailure=yes -o ServerAliveInterval=30)
if [ "$two_hop" = 1 ]; then
    if [ -z "$jump_socket" ]; then
        jump_user=$(ssh -G "$jump" 2>/dev/null | awk '$1 == "user" { print $2; exit }')
        [ -n "$jump_user" ] || die "cannot tell the user name on $jump (ssh -G); pass --jump-socket"
        jump_socket=/tmp/ubertooth-harness-$jump_user-$port.sock
    fi
    case $jump_socket in
        /*) ;;
        *) die "--jump-socket must be an absolute path" ;;
    esac
    case $jump_socket in
        *[!A-Za-z0-9._/@-]*) die "--jump-socket has characters this script does not quote: $jump_socket" ;;
    esac
    # The inner ssh runs on the jump host and creates the socket there, owner
    # only (mask 0177), replacing a stale one from an earlier tunnel.
    # RemoteCommand=none: a jump-host alias that sets RemoteCommand in its
    # ssh config would otherwise refuse the inner ssh ("Cannot execute
    # command-line and remote command").
    cmd=(ssh -t -o RemoteCommand=none "${opts[@]}" -L "127.0.0.1:$local_port:$jump_socket" "$jump"
         ssh -N "${opts[@]}" -o StreamLocalBindMask=0177 -o StreamLocalBindUnlink=yes
         -L "$jump_socket:127.0.0.1:$port" "$host")
elif [ -n "$jump" ]; then
    cmd=(ssh -N "${opts[@]}" -L "127.0.0.1:$local_port:127.0.0.1:$port" -J "$jump" "$host")
else
    cmd=(ssh -N "${opts[@]}" -L "127.0.0.1:$local_port:127.0.0.1:$port" "$host")
fi

url=http://127.0.0.1:$local_port/ui/
if [ "$dry_run" = 1 ]; then
    printf '%s\n' "${cmd[*]}"
    printf '%s\n' "$url"
    exit 0
fi

answers() { (exec 3<>"/dev/tcp/127.0.0.1/$local_port") 2>/dev/null; }

answers && die "127.0.0.1:$local_port is already in use on this machine (an old tunnel?); stop it or pass --local-port"

case $(uname -s) in
    Darwin) opener=open ;;
    *) opener=xdg-open ;;
esac

# The tunnel runs in the foreground (exec, below) so it owns the terminal for
# passwords and Ctrl-C; this background helper opens the browser once the
# forwarded port answers, and gives up if ssh exits or the wait runs out.
tunnel_pid=$$
(
    deadline=$((SECONDS + wait_s))
    while [ "$SECONDS" -lt "$deadline" ]; do
        kill -0 "$tunnel_pid" 2>/dev/null || exit 0
        if answers; then
            if [ "$browser" = 1 ]; then
                say "tunnel up; opening $url (Ctrl-C closes the tunnel)"
                "$opener" "$url" >/dev/null 2>&1 || say "could not run $opener; open $url yourself"
            else
                say "tunnel up: $url (Ctrl-C closes it)"
            fi
            exit 0
        fi
        sleep 0.5
    done
    say "127.0.0.1:$local_port did not answer within ${wait_s}s; is the controller running on $host?"
) &

say "connecting: ${cmd[*]}"
exec "${cmd[@]}"
