# Classic Bluetooth only: no BLE controller, no BLE host, so the whole radio
# and all of Bluedroid's memory go to BR/EDR.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# The Hands-Free Profile is how ESP-IDF lets an application open a
# synchronous (SCO/eSCO) link. Both roles are built in; only one runs at a
# time, which is what the board's role decides.
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y

# Audio over HCI, not the board's PCM pins: there is no codec chip here, and
# the frames have to reach the application, which is what sends the known
# pattern.
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BT_HFP_USE_EXTERNAL_CODEC=y

# Narrow-band speech only. Wide-band speech would have the two boards settle
# on mSBC, and then the bytes the application hands over are the bytes on the
# air, so it would have to produce real mSBC frames. With CVSD the controller
# does the coding and the application hands over plain 16-bit samples.
CONFIG_BT_HFP_WBS_ENABLE=n

# Room for a third baseband link. The controller allows two by default, and
# a follow test uses both of them at once: the pair's own link, and the one
# the host's Bluetooth adapter pages the leader with to read its clock. That
# leaves no headroom at all, and these boards are connectable, so anything
# else in the room that pages one is asking for a link the controller has no
# slot for. A third slot costs 1.2 KB of DRAM.
#
# This is headroom, not a fix for anything measured. It was tried because a
# peer restarting under exactly that second link is harness #311, but the
# bench then put 113 second links through a streaming initiator, on this
# image and on the one before it, with no restart either way. Harness #317
# found the real cause, and it is not on the air: a second process taking
# turns with the bridge resets the board. This slot is only a spare.
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=3

# Bluedroid with Classic does not fit the default 1 MB app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# The shell owns uart0, so keep the log quiet enough that a driver reading a
# response sees only command output. Warnings and errors still come through
# and are easy to tell apart: they start with "W (" or "E (".
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# The second-stage bootloader has its own level, and it prints the partition
# table on every boot. Keep that off the shell too.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
